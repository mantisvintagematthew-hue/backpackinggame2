extends SceneTree
var checks := 0
var failures := 0
var r: ItemRegistry
var sequences: Dictionary = {}
func check(ok: bool, description: String) -> void:
 checks += 1
 if not ok: failures += 1; printerr("FAIL: ",description)
 else: print("PASS: ",description)
func fresh() -> void:
 r = ItemRegistry.new()
 r.add_player(1)
 r.add_player(2)
 sequences.clear()
func cmd(op: String, id: String, extra: Dictionary = {}, peer := 1) -> String:
 sequences[peer] = int(sequences.get(peer,0))+1
 var req := {"op":op,"id":id,"seq":sequences[peer],"epoch":r.epoch,"rev":r.items[id].rev if r.items.has(id) else -1}
 req.merge(extra,true)
 return r.command(peer,req)
func put(kind: String, slot: String) -> String:
 return r.spawn(kind,Vector3.ZERO,r.pslot(1,slot))
func _initialize() -> void:
 fresh()
 var pack := put("pack","pack")
 var bottle := r.spawn("bottle",Vector3.ZERO,r.socket(pack,"in0"))
 var bag := r.spawn("bag",Vector3.ZERO,r.socket(pack,"ext0"))
 check(not r.accessible(1,bottle),"Worn internals inaccessible")
 check(r.accessible(1,bag),"Worn external slots accessible")
 check(not r.accessible(2,bag),"Teammate cannot loot worn pack")
 check(r.slots(1).size()==14,"Worn pack supplies four quick slots")
 check(cmd("equip",pack).is_empty(),"Worn pack to hands")
 check(r.accessible(1,bottle) and r.slots(1).size()==10,"Held pack opens internals, removes external hotbar")
 check(cmd("place",pack,{"pos":Vector3(1,0,0)}).is_empty(),"Held pack to world")
 check(r.accessible(2,bottle),"Placed pack shared access")
 check(cmd("equip",pack).is_empty() and cmd("wear",pack).is_empty(),"World to held to worn cycle")
 check(r.items[bottle].state.water == 1000 and r.items[bottle].loc == r.socket(pack,"in0"),"Pack content identity and water preserved")
 var pack2 := r.spawn("pack")
 check(not cmd("transfer",pack2,{"dest":r.socket(pack,"in1")}).is_empty(),"Nested pack rejected")
 fresh()
 var item := r.spawn("bottle")
 var initial_rev: int = r.items[item].rev
 check(cmd("equip",item).is_empty(),"First claimant takes item")
 check(not cmd("equip",item,{"rev":initial_rev},2).is_empty(),"Second claimant rejected")
 check(not r.command(1,{"op":"drink","id":item,"epoch":r.epoch,"seq":1,"rev":r.items[item].rev}).is_empty(),"Duplicate request rejected")
 r.near_check = func(_peer: int, _pos: Vector3): return false
 var remote := r.spawn("fuel")
 check(not cmd("equip",remote).is_empty(),"Out-of-reach transfer rejected")
 r.near_check = Callable()
 for slot: String in ["belt0","belt1","belt2","belt3","pocket0","pocket1","pocket2","pocket3"]: put("bottle",slot)
 var before := r.snapshot()
 check(not cmd("equip",remote).is_empty() and r.items == before.items,"Full inventory rejects equip without loss")
 fresh()
 var stove := r.spawn("stove")
 var fuel := put("fuel","belt0")
 var meal := put("meal","belt1")
 bottle = put("bottle","belt2")
 check(cmd("hydrate",meal).is_empty() and r.items[bottle].state.water==750,"Hydration transfers exactly 250 mL")
 check(not cmd("hydrate",meal).is_empty() and r.items[bottle].state.water==750,"Repeat hydrate cannot consume water")
 check(cmd("transfer",fuel,{"dest":r.socket(stove,"fuel")}).is_empty(),"Actual canister attaches to stove")
 check(cmd("transfer",meal,{"dest":r.socket(stove,"cook")}).is_empty(),"Actual meal enters cooking slot")
 r.tick(5)
 check(r.items[meal].state.heat==0,"No heat while stove off")
 check(cmd("ignite",stove).is_empty(),"Stove ignites with fuel")
 check(not cmd("equip",stove).is_empty(),"Burning stove cannot be packed")
 r.tick(4)
 check(r.items[meal].state.heat==4 and r.items[fuel].state.fuel==116,"Host advances fuel and cooking")
 cmd("ignite",stove)
 r.tick(10)
 check(r.items[meal].state.heat==4,"Extinguishing pauses accumulated cooking")
 cmd("ignite",stove)
 r.tick(6)
 check(r.items[meal].state.phase=="cooked","Meal cooked after ten seconds of burn")
 check(cmd("eat",meal).is_empty() and not r.items.has(meal) and r.players[1].hunger==85,"Consumption removes one meal and changes hunger")
 r.tick(110)
 check(not r.items[stove].state.burning and r.items[fuel].state.fuel==0,"Fuel exhaustion shuts stove down")
 bag = r.spawn("bag")
 cmd("roll",bag)
 check(cmd("rest",bag).is_empty(),"Enter unrolled bag")
 check(not cmd("rest",bag,{},2).is_empty() and not cmd("roll",bag).is_empty(),"Occupancy exclusive and rolling blocked")
 r.disconnect_player(1,Vector3.ZERO)
 check(r.items[bag].state.occupant==0,"Disconnect releases occupancy")
 check(r.invariants().is_empty(),"Camping invariants")
 fresh()
 var gun := put("pistol","hand0")
 var mag1 := put("p_mag","belt0")
 var mag2 := put("p_mag","belt1")
 var ammo := put("p_ammo","pocket0")
 for i in 5: cmd("load",mag1)
 for i in 10: cmd("load",mag2)
 check(r.items[mag1].state.rounds==5 and r.items[mag2].state.rounds==10 and r.items[ammo].state.count==45,"Detached magazines consume actual loose rounds")
 var total := r.ammo_total()
 check(cmd("reload",gun).is_empty(),"Timed reload starts")
 check(not cmd("fire",gun).is_empty(),"Reload blocks firing")
 check(r.at(r.socket(gun,"mag")).is_empty(),"Swap not committed before timer")
 r.tick(1.3)
 check(r.at(r.socket(gun,"mag"))==mag2 and r.items[mag2].state.rounds==9 and r.items[gun].state.chamber,"Reload picks fullest magazine and feeds empty chamber")
 cmd("insert",gun,{"target":mag1})
 r.tick(1.3)
 check(r.at(r.socket(gun,"mag"))==mag1 and r.items[mag1].state.rounds==5 and r.items[gun].state.chamber,"Tactical reload preserves chamber")
 check(r.items[mag2].loc == r.pslot(1,"belt0") and r.items[mag2].state.rounds==9,"Old magazine keeps ID and rounds in vacated slot")
 check(cmd("remove_mag",gun).is_empty(),"Explicit magazine removal")
 check(cmd("fire",gun).is_empty() and not r.items[gun].state.chamber,"Chambered gun with no magazine fires once")
 r.tick(1)
 check(not cmd("fire",gun).is_empty() and r.ammo_total()==total,"Dry fire preserves ammunition")
 cmd("insert",gun,{"target":mag1})
 r.tick(1.3)
 check(cmd("cycle",gun).is_empty() and r.ammo_total()==total,"Cycling creates recoverable round with conserved total")
 cmd("reload",gun)
 var old_mag := r.at(r.socket(gun,"mag"))
 cmd("drop",gun)
 r.tick(2)
 check(r.reloads.is_empty() and r.at(r.socket(gun,"mag"))==old_mag and r.ammo_total()==total,"Drop cancels reload without modifying ammo")
 cmd("equip",gun,{},2)
 check(r.held(2,gun) and r.ammo_total()==total,"Transfer firearm to teammate preserves state")
 cmd("fire",gun,{},2)
 check(not cmd("fire",gun,{},2).is_empty(),"Over-rate fire rejected")
 check(r.ammo_total()==total,"Ammunition conserved across all operations including shots")
 check(r.invariants().is_empty(),"Firearm/inventory invariants")
 r.disconnect_player(2,Vector3(2,0,0))
 check(String(r.items[gun].loc).begins_with("i:") and r.items[r.root_item(gun)].def=="crate","Disconnect moves gun and magazine into recovery crate")
 r.add_player(2)
 check(r.active(2).is_empty() and r.ammo_total()==total,"Reconnect receives empty loadout without copies")
 var epoch := r.epoch
 r.reset()
 check(r.epoch==epoch+1 and r.items.is_empty() and r.reloads.is_empty(),"Reset invalidates item epoch and timed actions")
 check(r.invariants().is_empty(),"Reset invariants")
 var v := VoiceHooks.new()
 check(not v.capture_enabled and v.gain_at(2)==1 and v.gain_at(20)==0,"Voice hooks have no capture and correct attenuation")
 print("DOMAIN_RESULT checks=",checks," failures=",failures)
 quit(0 if failures==0 else 1)
